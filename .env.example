# このファイルをコピーして .env を作り、値を埋める（.env は gitignore 済み）。
#
#   cp .env.example .env
#
# 読み込みは手動。アプリは dotenv を読まないので、使うときに source する:
#
#   set -a; . ./.env; set +a

# Postgres。docker の kb-pg コンテナに合わせた既定値。
KB_DSN="postgresql://postgres:devpass@localhost:55432/knowledge"

# KB トークンと API キーの暗号化鍵。未設定だと API 起動時に落ちる。
# 生成: uv run python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'
# **作り直すと保存済みのトークン・キーが全部読めなくなる**ので、一度決めたら固定する。
KB_SECRET_KEY=

# Gemini（Google AI Studio）の API キー。実機テスト
# tests/test_providers_gemini_live.py はこれが無いと skip する。
KB_GEMINI_API_KEY=

# 任意。ポーリング間隔（秒、既定 600）。
#KB_SYNC_INTERVAL_SECONDS=600

# 任意。設定すると email 通知チャネルが有効になる。
#KB_SMTP_HOST=
#KB_SMTP_PORT=25
#KB_SMTP_SENDER=
